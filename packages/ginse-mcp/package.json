{
  "name": "@ginse/mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "ginse-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/http.ts",
    "dev:mcp": "tsx src/index.ts",
    "start": "node dist/index.js",
    "start:api": "node dist/http.js",
    "compile": "tsx src/cli.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/multipart": "^9.0.3",
    "@ginse/skill-compiler": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.18.2",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "tsx": "^4.19.3"
  }
}
